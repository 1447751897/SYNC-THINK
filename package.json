{
  "name": "sync-think",
  "private": true,
  "version": "0.1.0-beta.1",
  "description": "SYNC-THINK local-first multi-model Agent desktop workspace",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "pretest": "node scripts/ensure-managed-pnpm.mjs",
    "dev:runtime": "pnpm --filter @sync-think/runtime dev",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "dev:runtime:pipe-test": "tsx scripts/pipe-client.mjs",
    "event:submit": "pnpm --filter @sync-think/runtime exec tsx src/daemon/external-event-submit.ts",
    "event:status": "pnpm --filter @sync-think/runtime exec tsx src/daemon/external-event-status.ts",
    "webhook:github": "pnpm --filter @sync-think/runtime exec tsx src/daemon/github-webhook-config.ts",
    "db:governance": "tsx packages/storage/src/scripts/database-governance.ts",
    "prebuild": "node scripts/ensure-managed-pnpm.mjs",
    "build": "turbo run build",
    "pretypecheck": "node scripts/ensure-managed-pnpm.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint --continue",
    "lint:tokens": "node scripts/check-design-tokens.mjs",
    "tokens:css": "node scripts/generate-shell-tokens.mjs",
    "format": "prettier --write .",
    "selftest:m1-soft": "node scripts/selftest-m1-soft-regression.mjs",
    "selftest:m1-soft:quick": "node scripts/selftest-m1-soft-regression.mjs --quick",
    "preselftest:m2": "node scripts/ensure-managed-pnpm.mjs",
    "selftest:m2": "node scripts/selftest-m2.mjs",
    "selftest:browser-handoff": "node scripts/selftest-browser-handoff-e2e.mjs all",
    "selftest:desktop-handoff": "node scripts/selftest-desktop-handoff-e2e.mjs all",
    "selftest:approval-reconnect": "node scripts/selftest-tool-approval-reconnect-e2e.mjs all",
    "selftest:codex-persistent": "pnpm tsx apps/runtime/src/kernel/codex-e2e-verify.ts",
    "test:release:win": "node --test scripts/windows-portable-release.test.mjs",
    "prerelease:stage:win": "pnpm build && pnpm release:assets:win && pnpm test:brand:win && pnpm test:release:win",
    "release:stage:win": "node scripts/windows-portable-release.mjs stage",
    "release:verify:win": "node scripts/windows-portable-release.mjs verify",
    "test:installer:win": "node --test scripts/windows-installer-release.test.mjs",
    "prepare:update-feed-fixture:win": "pnpm build && node scripts/windows-portable-release.mjs stage --signing-mode unsigned-fixture && node scripts/windows-installer-release.mjs build --signing-mode unsigned-fixture",
    "test:update-feed:prepared:win": "node --test scripts/windows-generic-update-feed.test.mjs && node scripts/selftest-windows-update-feed-e2e.mjs",
    "test:update-feed:win": "pnpm prepare:update-feed-fixture:win && pnpm test:update-feed:prepared:win",
    "prerelease:installer:win": "pnpm release:stage:win && pnpm test:installer:win",
    "release:installer:win": "node scripts/windows-installer-release.mjs build",
    "release:verify:installer:win": "node scripts/windows-installer-release.mjs verify",
    "release:smoke:installer:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-installer-smoke.ps1 -LeaveRunning",
    "test:brand:win": "node --test scripts/windows-brand-assets.test.mjs",
    "release:assets:win": "node scripts/windows-brand-assets.mjs generate",
    "release:verify:assets:win": "node scripts/windows-brand-assets.mjs verify",
    "test:update-install:win": "pnpm --filter @sync-think/desktop build && node scripts/windows-portable-release.mjs stage --signing-mode unsigned-fixture && node scripts/selftest-windows-update-install-e2e.mjs",
    "test:live-image-provider": "node --test scripts/live-image-provider-acceptance.test.mjs",
    "selftest:live-image-provider": "pnpm --filter @sync-think/adapters build && pnpm --filter @sync-think/runtime build && node scripts/live-image-provider-acceptance.mjs",
    "test:phase3": "node --test scripts/phase3-visual-capture.test.mjs scripts/selftest-phase3-exit.test.mjs",
    "capture:phase3": "pnpm --filter @sync-think/desktop build:shell:qa && node scripts/phase3-visual-capture.mjs",
    "selftest:phase3": "node scripts/selftest-phase3-exit.mjs"
  },
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.12.0",
    "prettier": "^3.4.2",
    "resedit": "1.7.2",
    "tsx": "^4.23.0",
    "turbo": "^2.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  },
  "dependencies": {
    "@sync-think/protocol": "workspace:*"
  }
}
