+/** Compact beUI liquid join for the workspace selected surface (local tab coords). */
+export const WORKSPACE_LIQUID_JOIN = 12;
+export const WORKSPACE_TAB_RADIUS = 12;
+export const WORKSPACE_LIQUID_APRON = 6;
+export const WORKSPACE_LIQUID_HEIGHT = 28;
+
+function coordinate(value: number): string {
+  return String(Number(value.toFixed(3)));
+}
+
+/**
+ * Local liquid tab path: rounded top + beUI C-curve shoulders + short apron.
+ * Designed to slide with transform3d — no per-frame layout measurement.
+ */
+export function workspaceLiquidTabPath(
+  width: number,
+  opts?: {
+    height?: number;
+    join?: number;
+    radius?: number;
+    apron?: number;
+  },
+): string {
+  const height = opts?.height ?? WORKSPACE_LIQUID_HEIGHT;
+  const join = opts?.join ?? WORKSPACE_LIQUID_JOIN;
+  const radius = Math.min(opts?.radius ?? WORKSPACE_TAB_RADIUS, Math.max(0, width / 2));
+  const apron = opts?.apron ?? WORKSPACE_LIQUID_APRON;
+  const bottom = height + apron;
+  const left = 0;
+  const right = width;
+  const leftJoin = -join;
+  const rightJoin = width + join;
+  const leftControl = join * 0.55;
+  const rightControl = join * 0.55;
+  return [
+    `M ${coordinate(leftJoin)} ${coordinate(bottom)}`,
+    `H ${coordinate(rightJoin)}`,
+    `V ${coordinate(height)}`,
+    `C ${coordinate(rightJoin - rightControl)} ${coordinate(height)} ${coordinate(right)} ${coordinate(height - join + rightControl)} ${coordinate(right)} ${coordinate(height - join)}`,
+    `V ${coordinate(radius)}`,
+    `Q ${coordinate(right)} 0 ${coordinate(right - radius)} 0`,
+    `H ${coordinate(left + radius)}`,
+    `Q ${coordinate(left)} 0 ${coordinate(left)} ${coordinate(radius)}`,
+    `V ${coordinate(height - join)}`,
+    `C ${coordinate(left)} ${coordinate(height - join + leftControl)} ${coordinate(leftJoin + leftControl)} ${coordinate(height)} ${coordinate(leftJoin)} ${coordinate(height)}`,
+    "Z",
+  ].join(" ");
+}
+
 export function tabTranslate(left: number): string {
   return `translate3d(${left}px, 0, 0)`;
 }
