        "8": ["#5a2b8a", "#8f66c9"],
        "fg": ["#ffffff", "rgba(0, 0, 0, 0.9)"]
      }
    },

    {
      "id": "syntax",
      "prefix": "--color-syntax-",
      "utilities": true,
      "_note": "Syntax highlighting (highlight.js).",
      "tokens": {
        "keyword": ["#7c6af0", "#b3a6ff"],
        "string": ["#2f9e6b", "#7ddea4"],
        "title": ["#3b82c4", "#7eb6ff"],
        "number": ["#c27803", "#f0b429"],
        "builtin": ["#0e9aa7", "#5fd0d6"]
      }
    },

    {
      "id": "shadow",
      "prefix": "--color-",
      "utilities": true,
      "_note": "Modal shadow is pinned to near-black in BOTH themes: light text tokens\n(e.g. dark-mode --color-text) would otherwise glow around the card. Dark\nuses a heavier drop so the card sits on, not above, the scrim.",
      "tokens": {
        "modal-shadow": [
          "color-mix(in srgb, #000 18%, transparent)",
          "color-mix(in srgb, #000 55%, transparent)"
        ]
      }
    },

