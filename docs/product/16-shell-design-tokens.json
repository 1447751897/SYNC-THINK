{
  "_comment": "SYNC-THINK shell design tokens — SINGLE SOURCE OF TRUTH for the desktop shell palette. Regenerate CSS with `pnpm tokens:css` (scripts/generate-shell-tokens.mjs → apps/desktop/src/renderer/shell/tokens.css). Never hand-edit tokens.css. Color values are written as [light, dark] tuples so every token is forced to declare both themes; a bare string means the token is theme-agnostic. Supersedes 15-frontend-design-tokens.json (the deleted legacy --st-* system, which carried a second, blue accent).",

  "output": "apps/desktop/src/renderer/shell/tokens.css",

  "groups": [
    {
      "id": "fonts",
      "prefix": "--font-",
      "utilities": true,
      "_note": "NewMax's bundled variable fonts are the primary shell faces. Components must consume these tokens rather than re-declaring a family so Latin and Chinese metrics stay consistent across the settings window and the rest of the desktop shell.",
      "tokens": {
        "sans": "'Inter Variable', Inter, 'Noto Sans SC Variable', 'Noto Sans SC', ui-sans-serif, system-ui, sans-serif",
        "serif": "'Noto Serif SC Variable', 'Noto Serif SC', Georgia, 'Songti SC', serif",
        "mono": "'Cascadia Code', 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
      }
    },

    {
      "id": "surfaces",
      "prefix": "--color-",
      "utilities": true,
      "_note": "NewMax 1.1.14 surface stack. Light uses its warm four-step ramp. Dark follows the current DS variables exactly: surface-100 #191a1a, app background surface-200 #1e1f1f, panels surface-300 #252726, and selected/hovered surface-400 #2a2d2b. The window gutter stays on the app background instead of becoming a bright gray band.",
      "tokens": {
        "page": ["#f2eee6", "#1e1f1f"],
        "page-gutter": ["#f2eee6", "#1e1f1f"],
        "sidebar": ["#f6f4ef", "#252726"],
        "surface": ["#faf9f5", "#252726"],
        "elevated": ["#f6f4ef", "#191a1a"],
        "overlay": ["#ffffff", "#2a2d2b"]
      }
    },

    {
      "id": "panels",
      "prefix": "--color-",
      "utilities": true,
      "_note": "Stage sub-surfaces. NewMax keeps the stage and tab strip on surface-200, raises active tabs to surface-300, and reserves surface-400 for selected rows and inset sections.",
      "tokens": {
        "panel": ["#faf9f5", "#1e1f1f"],
        "chat": ["#faf9f5", "#1e1f1f"],
        "recent": ["#f2eee6", "#2a2d2b"],
        "stage-tabs": ["#f6f4ef", "#1e1f1f"],
        "tab-active-border": ["#e7e4db", "rgba(255, 255, 255, 0.08)"],
        "tab-active-fill": ["#d5d1c6", "#252726"]
      }
    },

    {
      "id": "tabs",
      "prefix": "--shell-tab-",
      "utilities": false,
      "_note": "NewMax 1.1.14 tab-track primitives measured from the live client. These values drive the connected workspace SVG and the resource-tab hover/active surface without leaking component-specific effects into the global palette.",
      "tokens": {
        "hover": ["rgba(55, 61, 58, 0.06)", "rgba(168, 184, 176, 0.08)"],
        "outline": ["rgba(0, 0, 0, 0.04)", "rgba(255, 255, 255, 0.08)"],
        "highlight": ["rgba(255, 255, 255, 0.85)", "transparent"],
        "shadow": ["drop-shadow(0.5px 0.5px 0.5px rgba(0, 0, 0, 0.08))", "none"]
      }
    },

    {
      "id": "preference-palettes",
      "prefix": "--preference-color-",
      "utilities": false,
      "_note": "NewMax-aligned preference previews and runtime palette inputs. These colors are theme-agnostic source swatches; the preference engine derives active light/dark surfaces from them.",
      "tokens": {
        "image-lakewood-accent": "#042a18",
        "image-lakewood-background": "#eaebeb",
        "image-palm-shore-accent": "#6bbbda",
        "image-palm-shore-background": "#91d1e8",
        "image-ember-rock-accent": "#d89568",
        "image-ember-rock-background": "#cc704d",
        "image-atoll-blue-accent": "#cfaa92",
        "image-atoll-blue-background": "#ced3d4",
        "image-leaf-shadow-accent": "#6dcbff",
        "image-leaf-shadow-background": "#c8cdd1",
        "image-alpenglow-accent": "#00b3ad",
        "image-alpenglow-background": "#6bb3ae",
        "random-light-background": "#f5f7f6",
        "random-light-accent": "#4a7c6b",
        "random-dark-background": "#141716",
        "random-dark-accent": "#7ab89e",
        "default-light-background": "#faf8f3",
        "default-light-accent": "#2d4739",
        "default-dark-background": "#1e1f1f",
        "default-dark-accent": "#36d385",
        "azure-light-background": "#fbfbfb",
        "azure-light-accent": "#0a64d6",
        "azure-dark-background": "#232427",
        "azure-dark-accent": "#0a84ff",
        "professional-light-background": "#f4f7f6",
        "professional-light-accent": "#0056b3",
        "professional-dark-background": "#0a1628",
        "professional-dark-accent": "#7aadcc",
        "claude-light-background": "#faf9f5",
        "claude-light-accent": "#d97757",
        "claude-dark-background": "#262624",
        "claude-dark-accent": "#d97757",
        "luxury-light-background": "#f5f5f5",
        "luxury-light-accent": "#b8993a",
        "luxury-dark-background": "#1e1e1e",
        "luxury-dark-accent": "#c9b56a"
      }
    },

    {
      "id": "borders",
      "prefix": "--color-",
      "utilities": true,
      "tokens": {
        "border": ["#e7e4db", "rgba(255, 255, 255, 0.08)"],
        "border-strong": ["#d5d1c6", "rgba(255, 255, 255, 0.14)"]
      }
    },

    {
      "id": "text",
      "prefix": "--color-",
      "utilities": true,
      "tokens": {
        "text": ["#181b19", "rgba(255, 255, 255, 0.9)"],
        "text-secondary": ["#666763", "rgba(255, 255, 255, 0.5)"],
        "text-faint": ["#8c8c87", "rgba(255, 255, 255, 0.38)"],
        "text-inverse": ["#ffffff", "#ffffff"]
      }
    },

    {
      "id": "accent",
      "prefix": "--color-",
      "utilities": true,
      "_notes": {
        "accent-fg": "Foreground for text/icons sitting on --color-accent. Dark flips this to a near-black because the dark accent is a bright mint and white text on it fails contrast."
      },
      "tokens": {
        "accent": ["#2f9b5b", "#36d385"],
        "accent-soft": ["#e6f5ec", "rgba(54, 211, 133, 0.08)"],
        "accent-text": ["#1f6b3f", "#36d385"],
        "accent-fg": ["#ffffff", "rgba(0, 0, 0, 0.9)"],
        "settings-action": ["#2d4739", "#36d385"],
        "settings-action-fg": ["#ffffff", "rgba(0, 0, 0, 0.9)"]
      }
    },

    {
      "id": "states",
      "prefix": "--color-",
      "utilities": true,
      "_note": "NewMax interaction overlays with stable semantic control, selection and focus roles for future data-skin themes.",
      "tokens": {
        "hover": ["#efece3", "rgba(168, 184, 176, 0.08)"],
        "active": ["#f2eee6", "rgba(168, 184, 176, 0.16)"],
        "control": ["#ffffff", "#252726"],
        "control-hover": ["#efece3", "#2a2d2b"],
        "selection": ["#f2eee6", "#2a2d2b"],
        "selection-border": ["#2f9b5b", "#36d385"],
        "focus-ring": ["#247648", "#36d385"]
      }
    },

    {
      "id": "status",
      "prefix": "--color-",
      "utilities": true,
      "_note": "Status colors follow the theme: dark uses higher-luminance variants to\nhold contrast on the dark surfaces. `success` references accent directly\nso the two greens cannot drift apart across a theme switch.",
      "tokens": {
        "success": ["#2f9b5b", "#4ade80"],
        "error": ["#c4453d", "#e56555"],
        "warning": ["#b07d2a", "#e0a830"],
        "info": ["#3568a8", "#5b93d6"]
      }
    },

    {
      "id": "avatar",
      "prefix": "--color-avatar-",
      "utilities": true,
      "_note": "Deterministic avatar palette (hashed by name).",
      "tokens": {
        "1": ["#2f9b5b", "#36d385"],
        "2": ["#3568a8", "#5b93d6"],
        "3": ["#7c5ab8", "#a688e0"],
        "4": ["#b07d2a", "#d6a44e"],
        "5": ["#c4453d", "#e0716a"],
