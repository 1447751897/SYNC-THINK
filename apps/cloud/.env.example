# Development: copy to apps/cloud/.env. Process environment takes precedence.
CLOUD_ORIGIN=http://127.0.0.1:4175
CLOUD_HOST=127.0.0.1
CLOUD_PORT=4175

# Generate locally: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Empty = website preview only. Production requires a strong persistent secret.
CLOUD_AUTH_SECRET=

# Relative paths are resolved from the repository root.
CLOUD_DB_PATH=.data/cloud/auth.sqlite
CLOUD_WEBSITE_DIR=apps/website/dist

# Registration also requires an auth secret and SMTP configuration.
CLOUD_ALLOW_SIGNUP=false

# Enable only behind a local reverse proxy that overwrites X-Real-IP.
CLOUD_TRUST_PROXY=false

# /demo may be embedded by this site. Add other exact parent origins explicitly.
# Comma-separated HTTPS origins only; development also allows loopback HTTP.
# Example: https://portal.example.com,https://docs.example.com
CLOUD_EMBED_ORIGINS=

# Complete HOST and FROM to enable email. USER and PASSWORD are a pair.
# Port 587 uses required STARTTLS; port 465 normally uses SECURE=true.
CLOUD_SMTP_HOST=
CLOUD_SMTP_PORT=587
CLOUD_SMTP_SECURE=false
CLOUD_SMTP_USER=
CLOUD_SMTP_PASSWORD=
CLOUD_SMTP_FROM=
