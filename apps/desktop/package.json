{
  "name": "@sync-think/desktop",
  "version": "0.1.0-beta.1",
  "private": true,
  "type": "module",
  "main": "./dist/main/index.js",
  "files": [
    "dist",
    "build"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-preload.mjs && node scripts/build-shell.mjs",
    "build:shell": "node scripts/build-shell.mjs",
    "build:shell:dev": "node scripts/build-shell.mjs --mode development",
    "build:shell:qa": "node scripts/build-shell.mjs --mode qa",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --testTimeout=15000",
    "lint": "eslint src --ext .ts,.tsx && node ../../scripts/check-design-tokens.mjs",
    "dev": "node ../../scripts/dev-desktop.mjs",
    "dev:renderer": "node ../../scripts/dev-desktop.mjs --renderer-development",
    "start": "electron .",
    "start:shell": "electron ."
  },
  "dependencies": {
    "@sync-think/protocol": "workspace:*",
    "@sync-think/secure-store": "workspace:*",
    "@sync-think/shared": "workspace:*",
    "@sync-think/workers": "workspace:*",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "0.18.1",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "@sync-think/ui-kit": "workspace:*",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/highlight.js": "^10.1.0",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "electron": "^33.2.1",
    "esbuild": "^0.21.5",
    "highlight.js": "^11.11.1",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.16.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.4",
    "unified": "^11.0.5",
    "vitest": "^2.1.8"
  }
}
