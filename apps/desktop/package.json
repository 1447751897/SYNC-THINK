{
  "name": "@sync-think/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-preload.mjs && node scripts/build-renderer.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --ext .ts,.tsx",
    "dev": "node ../../scripts/dev-desktop.mjs",
    "start": "electron ."
  },
  "dependencies": {
    "@sync-think/protocol": "workspace:*",
    "@sync-think/shared": "workspace:*",
    "@sync-think/ui-kit": "workspace:*",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "electron": "^33.2.1",
    "esbuild": "^0.21.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.8"
  }
}
