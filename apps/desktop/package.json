{
  "name": "@sync-think/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-preload.mjs && node scripts/build-renderer.mjs && node scripts/build-shell.mjs",
    "build:shell": "node scripts/build-shell.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --ext .ts,.tsx",
    "dev": "node ../../scripts/dev-desktop.mjs",
    "start": "electron .",
    "start:legacy": "node -e \"process.env.SYNC_THINK_SHELL='0'; require('child_process').spawn('electron', ['.'], {stdio:'inherit', env:process.env, shell:true}).on('exit',c=>process.exit(c||0))\"",
    "start:shell": "electron ."
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.3",
    "@radix-ui/react-collapsible": "^1.1.17",
    "@radix-ui/react-context-menu": "^2.3.5",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "@radix-ui/react-scroll-area": "^1.2.16",
    "@radix-ui/react-select": "^2.3.5",
    "@radix-ui/react-switch": "^1.3.5",
    "@radix-ui/react-tabs": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.14",
    "@sync-think/protocol": "workspace:*",
    "@sync-think/shared": "workspace:*",
    "@sync-think/ui-kit": "workspace:*",
    "@tailwindcss/cli": "^4.3.3",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/highlight.js": "^10.1.0",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "electron": "^33.2.1",
    "esbuild": "^0.21.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.8"
  }
}
